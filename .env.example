# Postgres connection string.
# Vercel + Neon: run `vercel env pull` after adding the Neon integration and
# this gets filled in for you. Later on AWS, point it at your RDS instance —
# nothing else in the code changes.
DATABASE_URL=postgres://user:pass@host/dbname

# Needed to see counts and download the Excel at /admin.html
# Generate one: node -e "console.log(require('crypto').randomBytes(18).toString('hex'))"
ADMIN_KEY=change-me

PORT=3002
